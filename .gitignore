# Large dataset files and downloads - NEVER track these
graphzoom/dataset/raw_downloads/
graphzoom/dataset/*/raw/
graphzoom/dataset/*/processed/
graphzoom/dataset/*/*.npy
graphzoom/dataset/*/*.pkl  
graphzoom/dataset/*/*.adjlist
graphzoom/dataset/*/*.pt
graphzoom/dataset/*/*.npz

# Keep only essential small files in dataset folders
# (like .json, .mtx files for Cora, Citeseer, etc.)

# Results and outputs
embed_results/
results/
*.npy
*.pkl
*.pt
*.h5
*.hdf5

# Temporary and cache files
.cache/
__pycache__/
*.pyc
*.tmp

# OS files
.DS_Store
Thumbs.db

# BFG cleanup artifacts
.git.bfg-report/
bfg.jar

# Additional working directories
graphzoom/reduction_results/
