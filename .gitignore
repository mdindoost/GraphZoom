# Dataset files - never track these
graphzoom/dataset/raw_downloads/
graphzoom/dataset/*/raw/
graphzoom/dataset/*/processed/
graphzoom/dataset/*/*.npy
graphzoom/dataset/*/*.pkl
graphzoom/dataset/*/*.pt
graphzoom/dataset/*/*.npz
graphzoom/dataset/*/fused_*.mtx

# Keep only small essential files like .json, .mtx (not fused_*.mtx)
!graphzoom/dataset/*/*.json
!graphzoom/dataset/*/*.mtx
graphzoom/dataset/*/fused_*.mtx

# Results and tools
embed_results/
results/
reduction_results/
.git.bfg-report/
bfg.jar
